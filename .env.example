# Copiar a .env y cambiar los valores. Nunca subir .env al repositorio.
# Todas las credenciales son ficticias y solo para el laboratorio.

# --- API ---
API_PORT=8000
JWT_SECRET=cambiar-este-secreto-largo-y-aleatorio

# --- Web ---
WEB_PORT=3000

# --- Zona horaria de la agenda ---
CLINICA_TZ=America/Guayaquil

# --- PostgreSQL (agenda y citas) ---
POSTGRES_DB=clinica
POSTGRES_USER=clinica_app
POSTGRES_PASSWORD=cambiar-password-postgres

# --- MongoDB (catálogo) ---
# Replica set rs0 de un nodo, sin puerto publicado: solo accesible en la red interna
# de Docker (simplificación de laboratorio documentada en docs/fase4-implementacion.md).
MONGO_DB=catalogo

# --- Typesense (búsqueda) ---
TYPESENSE_API_KEY=cambiar-api-key-typesense

# --- Redis (filtros y borradores) ---
REDIS_PASSWORD=cambiar-password-redis
TTL_BORRADOR_SEGUNDOS=1800
TTL_BLOQUEO_CUPO_SEGUNDOS=300

# --- Sincronizador ---
SYNC_INTERVALO_MS=1000
